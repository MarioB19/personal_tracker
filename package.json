{
  "name": "tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:local": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "api:token": "node scripts/generate-local-api-token.mjs",
    "api:smoke": "node scripts/smoke-api.mjs",
    "agenda:backup": "node scripts/backup-agenda.mjs",
    "agenda:preview:madriz": "node scripts/apply-madriz-routine.mjs preview",
    "agenda:apply:madriz": "node scripts/apply-madriz-routine.mjs apply",
    "agenda:verify:madriz": "node scripts/verify-madriz-routine.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.18.0",
    "lucide-react": "^1.7.0",
    "next": "^16.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.72.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
